{
  "name": "Benchmark",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "description": "Categoria do benchmark (funil, unit_economics, capacidade)"
    },
    "metric_key": {
      "type": "string",
      "description": "Chave \u00fanica da m\u00e9trica"
    },
    "metric_label": {
      "type": "string",
      "description": "R\u00f3tulo da m\u00e9trica exibido no relat\u00f3rio"
    },
    "faixa_critica": {
      "type": "string",
      "description": "Faixa cr\u00edtica (vermelho)"
    },
    "faixa_aceitavel": {
      "type": "string",
      "description": "Faixa aceit\u00e1vel (amarelo)"
    },
    "faixa_ideal": {
      "type": "string",
      "description": "Faixa de alta performance (verde)"
    },
    "unidade": {
      "type": "string",
      "description": "Unidade da m\u00e9trica (% , R$, x, etc.)"
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o dentro da categoria"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "category",
    "metric_key",
    "metric_label"
  ]
}